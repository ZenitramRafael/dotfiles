# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"
# Terminal multiplexer
brew "tmux"
# Simple terminal UI for git commands
brew "lazygit"
# Cross-shell prompt
brew "starship"
# User-friendly command-line shell
brew "fish"
# Interpreted, interactive, object-oriented programming language
brew "python"
# JS runtime -- several nvim LSP servers (pyright, html/css, etc.) ship as
# npm packages and need node/npm on PATH for Mason to install them
brew "node"
# Fast file finder -- required by venv-selector.nvim (<leader>cv) and
# Snacks' file picker (<leader><space>)
brew "fd"
# Fast text search -- required by Snacks' live grep (<leader>/)
brew "ripgrep"
# App to build and share containerised applications and microservices
# Terminal emulator that uses platform-native UI and GPU acceleration
